{
  "name": "skyblock-helper",
  "productName": "SkyBlock Helper",
  "version": "1.0.2",
  "description": "Hypixel SkyBlock progress tracker",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "node desktop/release.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.absurdunicorn.skyblockhelper",
    "productName": "SkyBlock Helper",
    "files": [
      "index.html",
      "icons/**",
      "build/icon.png",
      "desktop/main.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "SkyBlock-Helper-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "SkyBlock Helper"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AbsurdUnicorn",
        "repo": "SkyblockHelper"
      }
    ]
  }
}
